# Variáveis de ambiente para rodar a API localmente sem Docker
# (ex.: `mvn spring-boot:run` ou via IDE). Copie para ".env" e exporte as
# variáveis no seu shell, ou use a run configuration "ApiApplication (dev)".
# Nunca commite um arquivo ".env" com valores reais de produção.
#
# Com profile "dev", application-dev.yml já traz estes defaults — este arquivo
# só é necessário se quiser sobrescrever.

SPRING_PROFILES_ACTIVE=dev
# Preferência local: 8090 (o front aponta para essa porta).
SERVER_PORT=8090

# ---- Banco de dados (PostgreSQL 16 já rodando) ----
# Postgres local deste projeto costuma usar a porta 5544 (.localpg).
DB_HOST=127.0.0.1
DB_PORT=5544
DB_NAME=infoprodutos
DB_USER=infoprodutos
DB_PASSWORD=infoprodutos

# ---- JWT ----
# Em dev há default em application-dev.yml. Em qualquer outro perfil, defina JWT_SECRET.
JWT_SECRET=dev-only-secret-troque-por-um-valor-aleatorio-de-32-bytes-ou-mais
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ---- CORS / cookies ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000

# URL pública usada em links assinados de stream (deve bater com SERVER_PORT).
API_PUBLIC_BASE_URL=http://localhost:8090
VIDEO_STORAGE_LOCAL_ROOT=./data/videos
CERTIFICATE_STORAGE_LOCAL_ROOT=./data/certificates

# ---- Seed de dados de desenvolvimento (perfil "dev") ----
# Contas locais padrão (só existem com profile=dev):
#   admin@dev.local      / DevAdmin123!
#   instrutor@dev.local  / DevInstructor123!
#   aluno@dev.local      / DevStudent123!
DEV_SEED_ENABLED=true
DEV_SEED_ADMIN_EMAIL=admin@dev.local
DEV_SEED_ADMIN_PASSWORD=DevAdmin123!
DEV_SEED_INSTRUCTOR_EMAIL=instrutor@dev.local
DEV_SEED_INSTRUCTOR_PASSWORD=DevInstructor123!
DEV_SEED_STUDENT_EMAIL=aluno@dev.local
DEV_SEED_STUDENT_PASSWORD=DevStudent123!

# ---- Mercado Pago (Checkout Pro: Pix + cartão) ----
# Coloque o access token em apps/api/.env (NÃO neste arquivo — .env.example vai pro git).
# Sem token no .env: checkout entra em mock e "compra" libera na hora, sem tela do MP.
# O boot carrega apps/api/.env automaticamente (IntelliJ / mvn).
MP_ACCESS_TOKEN=
# Se vazio: webhook aceito sem validar x-signature (dev). Em prod, use o secret do painel MP.
MP_WEBHOOK_SECRET=
MP_API_BASE_URL=https://api.mercadopago.com
MP_MOCK_WHEN_TOKEN_BLANK=true

# ---- E-mail (Resend). Sem chave: só loga (dev). ----
# Produção: verifique pksconsultoria.com.br no Resend e use:
# MAIL_FROM="PKS Consultoria <noreply@pksconsultoria.com.br>"
RESEND_API_KEY=
MAIL_FROM="PKS Consultoria <onboarding@resend.dev>"
