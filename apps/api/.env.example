# Variáveis de ambiente para rodar a API localmente sem Docker
# (ex.: `mvn spring-boot:run` ou via IDE). Copie para ".env" e exporte as
# variáveis no seu shell, ou configure-as diretamente na sua IDE.
# Nunca commite um arquivo ".env" com valores reais.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- Banco de dados (deve apontar para um PostgreSQL 16 já rodando) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infoprodutos
DB_USER=infoprodutos
DB_PASSWORD=infoprodutos

# ---- JWT ----
# Gere com: openssl rand -base64 48   (mínimo de 32 bytes / 256 bits, exigido pelo HS256)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ---- CORS / cookies ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000

# ---- Seed de dados de desenvolvimento (perfil "dev") ----
# Se e-mail/senha de um papel não forem definidos, esse usuário de
# desenvolvimento simplesmente não é criado.
DEV_SEED_ENABLED=true
DEV_SEED_ADMIN_EMAIL=admin@dev.local
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_INSTRUCTOR_EMAIL=instrutor@dev.local
DEV_SEED_INSTRUCTOR_PASSWORD=
DEV_SEED_STUDENT_EMAIL=aluno@dev.local
DEV_SEED_STUDENT_PASSWORD=
