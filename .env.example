# Copie este arquivo para ".env" antes de rodar `docker compose up`.
# Nunca commite o arquivo ".env" com valores reais.

# ---- Banco de dados ----
DB_NAME=infoprodutos
DB_USER=infoprodutos
DB_PASSWORD=changeme
DB_PORT=5432

# ---- Backend (api) ----
SPRING_PROFILES_ACTIVE=dev
API_PORT=8080
# Gere com: openssl rand -base64 48   (mínimo de 32 bytes / 256 bits, exigido pelo HS256)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Em produção (HTTPS), defina como true para que o cookie de refresh exija HTTPS.
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000
# Produção (domínio):
# FRONTEND_BASE_URL=https://pksconsultoria.com.br
# CORS_ALLOWED_ORIGINS=https://pksconsultoria.com.br,https://www.pksconsultoria.com.br
# API_PUBLIC_BASE_URL=https://api.pksconsultoria.com.br
# MAIL_FROM="PKS Consultoria <noreply@pksconsultoria.com.br>"
# Ver docs/DEPLOY_RENDER.md

# ---- Mercado Pago / e-mail (opcional em local; obrigatórios em prod) ----
# MP_WEBHOOK_SECRET: se vazio, a API não valida x-signature (ok em local).
# Em produção (Render), defina o secret do painel MP — ver docs/DEPLOY_RENDER.md.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MOCK_WHEN_TOKEN_BLANK=true
# Sem RESEND_API_KEY a API só loga e-mails (LoggingAppMailer).
RESEND_API_KEY=
MAIL_FROM="PKS Consultoria <onboarding@resend.dev>"

# ---- Seed de dados de desenvolvimento (apenas perfil "dev") ----
# Se o e-mail/senha de um papel não forem definidos, o respectivo usuário de
# desenvolvimento simplesmente não é criado (nenhuma senha padrão é usada).
DEV_SEED_ENABLED=true
DEV_SEED_ADMIN_EMAIL=admin@dev.local
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_INSTRUCTOR_EMAIL=instrutor@dev.local
DEV_SEED_INSTRUCTOR_PASSWORD=
DEV_SEED_STUDENT_EMAIL=aluno@dev.local
DEV_SEED_STUDENT_PASSWORD=

# ---- Vídeos / IA (backend) ----
# Em desenvolvimento local sem Docker, se a API subir em :8090, use a mesma porta aqui.
API_PUBLIC_BASE_URL=http://localhost:8080
VIDEO_STORAGE_LOCAL_ROOT=./data/videos
# 2 GiB — aulas longas (20+ min). Com R2 o upload não passa pela API.
VIDEO_STORAGE_MAX_FILE_BYTES=2147483648
VIDEO_STREAM_URL_TTL_SECONDS=300
# Cloudflare R2 / S3 (produção). Local: deixe enabled=false.
VIDEO_S3_ENABLED=false
VIDEO_S3_ENDPOINT=
VIDEO_S3_REGION=auto
VIDEO_S3_BUCKET=
VIDEO_S3_ACCESS_KEY=
VIDEO_S3_SECRET_KEY=
# VIDEO_S3_PUBLIC_BASE_URL=
# Ver docs/DEPLOY_VIDEO_R2.md
AI_PROVIDER=mock
AI_JOB_MAX_ATTEMPTS=3
AI_DEFAULT_QUESTION_COUNT=5

# ---- Frontend (web) ----
WEB_PORT=3000
# Local sem Docker costuma usar API em :8090 (veja apps/web/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Fallback PROXY (multipart) quando R2 está off — em prod na Vercel use a URL do Render:
# NEXT_PUBLIC_API_UPLOAD_URL=https://infoprodutos-api.onrender.com/api/v1
